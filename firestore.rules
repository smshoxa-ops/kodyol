rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // забаненный пользователь теряет доступ ко всему (кроме чтения своей записи бана)
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function isMember(chatId) {
      return signedIn() && (chatId == 'general' || request.auth.uid in chatId.split('_'));
    }
    function isOwner() { return signedIn() && request.auth.uid == "bzZme2xA34ciRWWo7xxwsY98IF63"; }
    function banned() { return exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    // Вложение в сообщении (фото или файл): только метаданные и маленькое превью
    function validAtt(d) {
      return !('att' in d) || (
        d.att is map
        && d.att.keys().hasOnly(['k','n','s','t','th','fid'])
        && d.att.k in ['img','file']
        && d.att.n is string && d.att.n.size() <= 100
        && d.att.s is number && d.att.s <= 700000
        && d.att.t is string && d.att.t.size() <= 100
        && d.att.fid is string && d.att.fid.size() <= 40
        && (!('th' in d.att) || (d.att.th is string && d.att.th.size() <= 30000 && d.att.th[0:23] == 'data:image/jpeg;base64,'))
      );
    }
    function onlyOwnKey(after, before, field) {
      return after.get(field, {}).diff(before.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Профили: читать могут вошедшие, писать только владелец
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','nl','username','bio','photo','banner','learned','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._]{3,20}$')
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 150
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 30000
        && (!('banner' in request.resource.data) || (request.resource.data.banner is string && request.resource.data.banner.size() <= 65000))
        && request.resource.data.learned is number;
      allow delete: if false;
    }

    // Реестр уникальных username
    match /usernames/{n} {
      allow read: if signedIn();
      allow create: if signedIn() && n.matches('^[a-z0-9._]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // Подписки
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['a','b','ts'])
        && request.resource.data.a == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.b;
      allow delete: if signedIn() && resource.data.a == request.auth.uid;
      allow update: if false;
    }

    // Личные чаты: id = "uidA_uidB" (отсортированные), доступ только участникам
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && chatId != 'general'
        && chatId.split('_').size() == 2
        && request.auth.uid in chatId.split('_')
        && request.resource.data.members == chatId.split('_')
        && request.resource.data.keys().hasOnly(['members','last','lu','ts','rd','del'])
        && request.resource.data.get('lu', request.auth.uid) == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members','last','lu','ts','rd','del'])
        && (request.resource.data.get('lu', null) == resource.data.get('lu', null)
            || request.resource.data.get('lu', null) == request.auth.uid)
        && onlyOwnKey(request.resource.data, resource.data, 'rd')
        && onlyOwnKey(request.resource.data, resource.data, 'del');
      allow delete: if false;

      match /msgs/{msgId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && !banned()
          && request.resource.data.keys().hasOnly(['uid','name','photo','text','ts','att'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.ts == request.time
          && validAtt(request.resource.data);
        // «удалить у себя»: можно только добавить свой uid в hid
        allow update: if isMember(chatId) && chatId != 'general'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hid'])
          && request.resource.data.hid.toSet().difference(resource.data.get('hid', []).toSet()).hasOnly([request.auth.uid]);
        // владелец может удалять сообщения только в общем чате
        allow delete: if chatId == 'general' && isOwner();
      }

      // Содержимое вложений (до ~680 КБ): читают участники чата, создаёт автор, менять нельзя
      match /files/{fid} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && !banned()
          && request.resource.data.keys().hasOnly(['uid','name','type','sz','data','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.type is string && request.resource.data.type.size() <= 100
          && request.resource.data.sz is number && request.resource.data.sz <= 700000
          && request.resource.data.data is string && request.resource.data.data.size() <= 950000
          && request.resource.data.ts == request.time;
        allow update: if false;
        allow delete: if chatId == 'general' && isOwner();
      }
    }

    // Голосовые звонки 1 на 1 (WebRTC): сигналинг через документ звонка
    function callMember(callId) {
      let c = get(/databases/$(database)/documents/calls/$(callId)).data;
      return signedIn() && (c.from == request.auth.uid || c.to == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from','to','fromName','status','offer','ts','video'])
        && request.resource.data.get('video', false) is bool
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 30
        && request.resource.data.ts == request.time;
      allow update: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer'])
        && request.resource.data.status in ['active','ended','declined'];
      allow delete: if false;

      match /ice/{id} {
        allow read: if callMember(callId);
        allow create: if callMember(callId)
          && request.resource.data.keys().hasOnly(['uid','c'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.c is string && request.resource.data.c.size() < 2000;
        allow update, delete: if false;
      }
    }

    // «В сети»: время последней активности, пишет только владелец
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow delete: if false;
    }

    // Платный доступ к ИИ: покупатель читает свой документ, писать может только владелец (впиши свой код вместо ADMIN_UID)
    match /subs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == "bzZme2xA34ciRWWo7xxwsY98IF63");
      allow write: if signedIn() && request.auth.uid == "bzZme2xA34ciRWWo7xxwsY98IF63"
        && request.resource.data.keys().hasOnly(["until"]) && request.resource.data.until is timestamp;
    }

    // Токены push-уведомлений: только владелец (сервер читает через Admin SDK)
    match /fcm/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens','ts'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 20;
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    // Истории (24 ч): видят вошедшие, создаёт и удаляет автор (или владелец)
    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','type','img','ts','exp'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'photo'
        && request.resource.data.ts == request.time
        && request.resource.data.exp is number
        && request.resource.data.exp <= request.time.toMillis() + 90000000
        && request.resource.data.img is string && request.resource.data.img.size() <= 720000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
      allow update: if false;

      // Просмотры и лайки истории: id документа = uid смотревшего
      match /v/{viewer} {
        allow get: if signedIn() && (request.auth.uid == viewer || isOwner()
          || get(/databases/$(database)/documents/stories/$(id)).data.uid == request.auth.uid);
        allow list: if signedIn() && (isOwner()
          || get(/databases/$(database)/documents/stories/$(id)).data.uid == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == viewer
          && request.resource.data.keys().hasOnly(['ts','lk'])
          && request.resource.data.ts == request.time
          && request.resource.data.lk is bool;
        allow update: if signedIn() && request.auth.uid == viewer
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lk'])
          && request.resource.data.lk is bool;
        allow delete: if false;
      }
    }

    // Reels: видео хранится кусками в rchunks, метаданные и счётчики в reels
    function rlStep(k) {
      return request.resource.data[k] is number
        && request.resource.data[k] >= 0
        && request.resource.data[k] - resource.data[k] in [-1, 0, 1];
    }
    match /reels/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','cap','dur','sz','n','mime','url','th','lk','cm','rp','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 150
        && request.resource.data.dur is number && request.resource.data.dur <= 61
        && request.resource.data.sz is number && request.resource.data.sz <= 31457280
        && request.resource.data.n is number && request.resource.data.n >= 0 && request.resource.data.n <= 6
        && (request.resource.data.n >= 1 || ('url' in request.resource.data && request.resource.data.url is string
            && request.resource.data.url.matches('^https://pgjpmgevsvyuuchvqlca[.]supabase[.]co/storage/v1/object/public/reels/.*')))
        && request.resource.data.mime is string && request.resource.data.mime.size() <= 60
        && request.resource.data.th is string && request.resource.data.th.size() <= 30000
        && request.resource.data.lk == 0 && request.resource.data.cm == 0 && request.resource.data.rp == 0
        && request.resource.data.ts == request.time;
      // счётчики лайков, комментариев и репостов: любой вошедший, только на ±1
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lk','cm','rp'])
        && rlStep('lk') && rlStep('cm') && rlStep('rp');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts']) && request.resource.data.ts == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
      match /rps/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts']) && request.resource.data.ts == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
      match /cm/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid','text','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.ts == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/reels/$(id)).data.uid == request.auth.uid
          || isOwner());
      }
    }
    // куски видео (до ~640 КБ в base64 каждый)
    match /rchunks/{cid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['rid','i','uid','d','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rid is string && request.resource.data.rid.size() <= 40
        && request.resource.data.i is number && request.resource.data.i >= 0 && request.resource.data.i < 6
        && cid == request.resource.data.rid + '_' + string(request.resource.data.i)
        && request.resource.data.d is string && request.resource.data.d.size() <= 800000
        && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }

    // Жалобы: создаёт любой вошедший, читает и закрывает только владелец
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['chat','msg','by','txt','from','fn','ts'])
        && request.resource.data.ts == request.time;
      allow read, delete: if isOwner();
      allow update: if false;
    }

    // Поддержка: пользователь создаёт обращение и читает только свои; владелец читает всё, отвечает и удаляет
    match /support/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','un','cat','txt','st','ts'])
        && request.resource.data.txt is string
        && request.resource.data.txt.size() >= 10 && request.resource.data.txt.size() <= 1000
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.un is string && request.resource.data.un.size() <= 20
        && request.resource.data.st == 'new'
        && request.resource.data.ts == request.time;
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','reply','rts'])
        && request.resource.data.st == 'done'
        && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 500));
      allow delete: if isOwner();
    }

    // Галочки: читают все вошедшие, выдаёт и снимает только владелец
    match /verified/{uid} {
      allow read: if signedIn();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['by','ts']);
      allow delete: if isOwner();
      allow update: if false;
    }

    // Блокировки: ставит и снимает только владелец; пользователь видит только свою
    match /bans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == "bzZme2xA34ciRWWo7xxwsY98IF63");
      allow create: if isOwner() && uid != request.auth.uid && request.resource.data.keys().hasOnly(['by','ts']);
      allow delete: if isOwner();
      allow update: if false;
    }
    // Прогресс уроков (Duolingo-стиль): читает и пишет только сам владелец
    match /progress/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tr','done','xp','chest','ts'])
        && request.resource.data.tr is string && request.resource.data.tr.size() <= 3
        && request.resource.data.done is map && request.resource.data.done.size() <= 100
        && request.resource.data.chest is map && request.resource.data.chest.size() <= 100
        && request.resource.data.xp is number && request.resource.data.xp >= 0 && request.resource.data.xp < 1000000
        && request.resource.data.ts is number;
      allow delete: if false;
    }
  }
}
